# Django
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is off. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send unsafe requests (Vite dev server by default in debug)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Job Watcher
# Directory that holds the SQLite database (default: backend/data)
JOB_WATCHER_DATA_DIR=
# Timezone for the daily scheduled checks
JOB_WATCHER_TIMEZONE=America/Sao_Paulo
# Built React app served by Django (default: ../frontend/dist)
JOB_WATCHER_FRONTEND_DIST=
JOB_WATCHER_LOG_LEVEL=INFO

# v2 integrations. Keys are normally saved from Settings into
# <data dir>/secrets.json; these env vars win over that file when set.
GEMINI_API_KEY=
GITHUB_TOKEN=
GEMINI_MODEL=gemini-3.7-flash
# Gupy portal endpoint, only if it ever moves
GUPY_API=https://employability-portal.gupy.io/api/v1/jobs
# Optional override of the secrets file location
JOB_WATCHER_SECRETS_FILE=
